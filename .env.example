# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bikeledger?retryWrites=true&w=majority

# JWT signing secret: use a long, random value and keep it private
JWT_SECRET=replace-with-a-long-random-secret

PORT=5000
CLIENT_URL=http://localhost:5173

# Used only for the one-time admin creation script
ADMIN_NAME=BikeLedger Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
