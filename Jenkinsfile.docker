

pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out BikeLedger source code'
            }
        }

        stage('Verify Docker') {
            steps {
                bat 'docker --version'
                bat 'docker info'
            }
        }

        stage('Build Backend Image') {
            steps {
                bat 'docker build -t bikeledger-server:latest ./server'
            }
        }

        stage('Build Production Frontend Image') {
            steps {
                bat 'docker build -f client/Dockerfile.prod -t bikeledger-client-prod:latest ./client'
            }
        }

        stage('Verify Images') {
            steps {
                bat 'docker images'
            }
        }
    }

    post {
        success {
            echo 'BikeLedger Docker images built successfully!'
        }

        failure {
            echo 'Docker pipeline failed. Check Console Output.'
        }
    }
}
