
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        EC2_HOST          = '15.134.65.78'
        REMOTE_BUILD_ROOT = '/home/ec2-user/ci-builds'
        DEPLOY_DIR        = '/home/ec2-user/BikeLedger-Docker'

        DOCKERHUB_USER = 'shanumukh'
        BACKEND_IMAGE  = 'shanumukh/bikeledger-backend'
        FRONTEND_IMAGE = 'shanumukh/bikeledger-frontend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'GitHub source code checked out successfully.'
            }
        }

        stage('Prepare Deployment Package') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"

                    Write-Host "Preparing BikeLedger deployment package..."

                    $workspace = $env:WORKSPACE
                    $stage = Join-Path $workspace "deployment-package"
                    $zipFile = Join-Path $workspace "BikeLedger-deployment.zip"

                    if (Test-Path $stage) {
                        Remove-Item $stage -Recurse -Force
                    }

                    if (Test-Path $zipFile) {
                        Remove-Item $zipFile -Force
                    }

                    New-Item -ItemType Directory -Path $stage -Force | Out-Null

                    Write-Host "Copying project source files..."

                    robocopy $workspace $stage /E `
                        /XD .git node_modules deployment-package dist build `
                        /XF ".env" ".env.*" "BikeLedger-deployment.zip"

                    $copyCode = $LASTEXITCODE

                    if ($copyCode -ge 8) {
                        throw "Robocopy failed with exit code $copyCode"
                    }

                    $global:LASTEXITCODE = 0

                    Write-Host "Source files copied successfully. Robocopy exit code: $copyCode"

                    # Validate required Dockerfiles.
                    $backendDockerfile = Join-Path $stage "server/Dockerfile"
                    $frontendDockerfile = Join-Path $stage "client/Dockerfile.prod"

                    if (!(Test-Path $backendDockerfile)) {
                        throw "Missing server/Dockerfile."
                    }

                    if (!(Test-Path $frontendDockerfile)) {
                        throw "Missing client/Dockerfile.prod."
                    }

                    # Create ZIP using PowerShell 5.1 compatible paths.
                    Add-Type -AssemblyName System.IO.Compression
                    Add-Type -AssemblyName System.IO.Compression.FileSystem

                    Write-Host "Creating deployment ZIP..."

                    $fileStream = [System.IO.File]::Open(
                        $zipFile,
                        [System.IO.FileMode]::Create
                    )

                    try {
                        $archive = New-Object System.IO.Compression.ZipArchive(
                            $fileStream,
                            [System.IO.Compression.ZipArchiveMode]::Create
                        )

                        try {
                            $rootPath = $stage.TrimEnd([char[]]@('\','/')) + '\'

                            Get-ChildItem -Path $stage -Recurse -File |
                                ForEach-Object {

                                    $file = $_

                                    # PowerShell 5.1 compatible relative path.
                                    $relativePath = $file.FullName.Substring(
                                        $rootPath.Length
                                    )

                                    # ZIP paths must use forward slashes.
                                    $entryName = $relativePath.Replace('\','/')

                                    [System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile(
                                        $archive,
                                        $file.FullName,
                                        $entryName
                                    ) | Out-Null
                                }
                        }
                        finally {
                            $archive.Dispose()
                        }
                    }
                    finally {
                        $fileStream.Dispose()
                    }

                    # Validate ZIP contents.
                    Write-Host "Validating ZIP contents..."

                    $checkArchive = [System.IO.Compression.ZipFile]::OpenRead($zipFile)

                    try {
                        $entries = @(
                            $checkArchive.Entries |
                            ForEach-Object { $_.FullName }
                        )

                        if ($entries -notcontains "server/Dockerfile") {
                            throw "ZIP validation failed: server/Dockerfile missing."
                        }

                        if ($entries -notcontains "client/Dockerfile.prod") {
                            throw "ZIP validation failed: client/Dockerfile.prod missing."
                        }

                        if ($entries -notcontains "client/nginx.conf") {
                            throw "ZIP validation failed: client/nginx.conf missing."
                        }

                        Write-Host "ZIP entries validated successfully."
                    }
                    finally {
                        $checkArchive.Dispose()
                    }

                    Write-Host "Deployment ZIP created successfully."
                    Write-Host "ZIP file: $zipFile"
                '''
            }
        }

        stage('Deploy to AWS EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'bikeledger-ec2-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    ),
                    file(
                        credentialsId: 'bikeledger-env',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $buildTag = "build-$env:BUILD_NUMBER"

                        $hostName = $env:EC2_HOST
                        $remoteUser = $env:SSH_USER

                        $buildDir = "$env:REMOTE_BUILD_ROOT/BikeLedger-$buildTag"
                        $deployDir = $env:DEPLOY_DIR

                        $zipFile = Join-Path $env:WORKSPACE "BikeLedger-deployment.zip"
                        $composeFile = Join-Path $env:WORKSPACE "docker-compose.prod.yml"

                        $extractScript = Join-Path $env:WORKSPACE "extract-deployment.sh"
                        $deployScript = Join-Path $env:WORKSPACE "deploy-bikeledger.sh"

                        if (!(Test-Path $zipFile)) {
                            throw "Deployment ZIP not found."
                        }

                        if (!(Test-Path $composeFile)) {
                            throw "docker-compose.prod.yml not found."
                        }

                        if (!(Test-Path $env:ENV_FILE)) {
                            throw "Jenkins environment credential not found."
                        }

                        # Configure SSH private-key permissions.
                        $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

                        & icacls.exe $env:SSH_KEY /inheritance:r
                        & icacls.exe $env:SSH_KEY /grant:r "$($identity):(R)"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Unable to configure SSH key permissions."
                        }

                        $sshOptions = @(
                            "-i", $env:SSH_KEY,
                            "-o", "StrictHostKeyChecking=no",
                            "-o", "ConnectTimeout=20"
                        )

                        # Test SSH.
                        Write-Host "Testing SSH connection to EC2..."

                        & ssh @sshOptions "$remoteUser@$hostName" "echo SSH connection successful"

                        if ($LASTEXITCODE -ne 0) {
                            throw "SSH connection failed."
                        }

                        # Verify existing root Docker Hub authentication.
                        Write-Host "Checking EC2 Docker authentication..."

                        & ssh @sshOptions "$remoteUser@$hostName" "sudo -n test -s /root/.docker/config.json"

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 root Docker Hub authentication is unavailable."
                        }

                        # Create isolated build directory.
                        # Existing /home/ec2-user/BikeLedger is not modified.
                        $prepareCommand = "mkdir -p '$buildDir' '$deployDir' && find '$buildDir' -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +"

                        & ssh @sshOptions "$remoteUser@$hostName" $prepareCommand

                        if ($LASTEXITCODE -ne 0) {
                            throw "Unable to prepare EC2 directories."
                        }

                        # Upload ZIP.
                        Write-Host "Uploading deployment ZIP..."

                        & scp @sshOptions $zipFile "$remoteUser@${hostName}:$buildDir/BikeLedger-deployment.zip"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Deployment ZIP upload failed."
                        }

                        # Upload Docker Compose.
                        Write-Host "Uploading Docker Compose file..."

                        & scp @sshOptions $composeFile "$remoteUser@${hostName}:$deployDir/docker-compose.prod.yml"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker Compose upload failed."
                        }

                        # Upload .env securely from Jenkins Secret File.
                        Write-Host "Uploading environment file..."

                        & scp @sshOptions $env:ENV_FILE "$remoteUser@${hostName}:$deployDir/.env"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Environment file upload failed."
                        }

                        # Create extraction script.
                        $extractContent = @'
#!/bin/bash
set -euo pipefail

BUILD_DIR="__BUILD_DIR__"
DEPLOY_DIR="__DEPLOY_DIR__"
ZIP_FILE="$BUILD_DIR/BikeLedger-deployment.zip"

echo "Extracting BikeLedger deployment package..."

python3 -m zipfile -e "$ZIP_FILE" "$BUILD_DIR"

test -d "$BUILD_DIR/server"
test -d "$BUILD_DIR/client"

test -f "$BUILD_DIR/server/Dockerfile"
test -f "$BUILD_DIR/client/Dockerfile.prod"
test -f "$BUILD_DIR/client/nginx.conf"

chmod 600 "$DEPLOY_DIR/.env"

echo "Deployment package extracted and validated successfully."
'@

                        $extractContent = $extractContent.Replace("__BUILD_DIR__", $buildDir)
                        $extractContent = $extractContent.Replace("__DEPLOY_DIR__", $deployDir)

                        [System.IO.File]::WriteAllText(
                            $extractScript,
                            $extractContent.Replace("`r`n", "`n"),
                            [System.Text.Encoding]::ASCII
                        )

                        & scp @sshOptions $extractScript "$remoteUser@${hostName}:$buildDir/extract-deployment.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Extraction script upload failed."
                        }

                        Write-Host "Extracting source files on EC2..."

                        $extractCommand = "chmod +x '$buildDir/extract-deployment.sh' && bash '$buildDir/extract-deployment.sh'"

                        & ssh @sshOptions "$remoteUser@$hostName" $extractCommand

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 source extraction failed."
                        }

                        # Create Docker deployment script.
                        $deployContent = @'
#!/bin/bash
set -euo pipefail

BUILD_DIR="__BUILD_DIR__"
DEPLOY_DIR="__DEPLOY_DIR__"
BUILD_TAG="__BUILD_TAG__"

BACKEND_IMAGE="shanumukh/bikeledger-backend"
FRONTEND_IMAGE="shanumukh/bikeledger-frontend"

echo "======================================"
echo " BIKELEDGER DOCKER CI/CD"
echo " BUILD: $BUILD_TAG"
echo "======================================"

test -f "$BUILD_DIR/server/Dockerfile"
test -f "$BUILD_DIR/client/Dockerfile.prod"
test -f "$DEPLOY_DIR/docker-compose.prod.yml"
test -s "$DEPLOY_DIR/.env"

cd "$DEPLOY_DIR"

echo "Building backend Docker image..."

sudo docker build \
    -t "$BACKEND_IMAGE:$BUILD_TAG" \
    -t "$BACKEND_IMAGE:latest" \
    "$BUILD_DIR/server"

echo "Building frontend Docker image..."

sudo docker build \
    --build-arg VITE_API_URL=/api \
    -t "$FRONTEND_IMAGE:$BUILD_TAG" \
    -t "$FRONTEND_IMAGE:latest" \
    "$BUILD_DIR/client"

echo "Pushing backend images..."

sudo docker push "$BACKEND_IMAGE:$BUILD_TAG"
sudo docker push "$BACKEND_IMAGE:latest"

echo "Pushing frontend images..."

sudo docker push "$FRONTEND_IMAGE:$BUILD_TAG"
sudo docker push "$FRONTEND_IMAGE:latest"

echo "Validating Docker Compose configuration..."

sudo docker compose \
    --env-file .env \
    -f docker-compose.prod.yml \
    config -q

echo "Deploying BikeLedger containers..."

sudo env IMAGE_TAG="$BUILD_TAG" docker compose \
    --env-file .env \
    -f docker-compose.prod.yml \
    up -d --force-recreate

echo "Waiting for containers to start..."
sleep 10

echo "======================================"
echo " CONTAINER STATUS"
echo "======================================"

sudo docker ps --filter "name=bikeledger-docker"

echo "======================================"
echo " BACKEND LOGS"
echo "======================================"

sudo docker logs --tail 50 bikeledger-docker-server || true

echo "======================================"
echo " FRONTEND LOGS"
echo "======================================"

sudo docker logs --tail 30 bikeledger-docker-client || true

echo "======================================"
echo " BIKELEDGER DEPLOYMENT COMPLETED"
echo "======================================"
'@

                        $deployContent = $deployContent.Replace("__BUILD_DIR__", $buildDir)
                        $deployContent = $deployContent.Replace("__DEPLOY_DIR__", $deployDir)
                        $deployContent = $deployContent.Replace("__BUILD_TAG__", $buildTag)

                        [System.IO.File]::WriteAllText(
                            $deployScript,
                            $deployContent.Replace("`r`n", "`n"),
                            [System.Text.Encoding]::ASCII
                        )

                        & scp @sshOptions $deployScript "$remoteUser@${hostName}:$deployDir/deploy-bikeledger.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Deployment script upload failed."
                        }

                        Write-Host "Starting Docker deployment on EC2..."

                        $remoteDeployCommand = "chmod +x '$deployDir/deploy-bikeledger.sh' && bash '$deployDir/deploy-bikeledger.sh'"

                        & ssh @sshOptions "$remoteUser@$hostName" $remoteDeployCommand

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker deployment failed on EC2."
                        }

                        Write-Host "BikeLedger deployment completed successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '''
            ==========================================
              BIKELEDGER DEPLOYMENT SUCCESSFUL
            ==========================================
              Frontend: http://15.134.65.78:8080
              Backend:  Running inside Docker
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
              BIKELEDGER DEPLOYMENT FAILED
            ==========================================
              Check the failed stage in Console Output.
            ==========================================
            '''
        }

        always {
            echo 'BikeLedger CI/CD pipeline execution finished.'
        }
    }
}
