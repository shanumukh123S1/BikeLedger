
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        EC2_HOST = '15.134.65.78'
        DEPLOY_DIR = '/home/ec2-user/BikeLedger-Docker'
        DOCKERHUB_USER = 'shanumukh'

        BACKEND_IMAGE = 'shanumukh/bikeledger-backend'
        FRONTEND_IMAGE = 'shanumukh/bikeledger-frontend'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT SOURCE CODE
        // ==========================================

        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        // ==========================================
        // 2. PREPARE LINUX-COMPATIBLE ZIP
        // ==========================================

        stage('Prepare Deployment Package') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"

                    $stage = Join-Path $env:WORKSPACE "deployment-package"
                    $zip = Join-Path $env:WORKSPACE "bikeledger-deploy.zip"

                    if (Test-Path $stage) {
                        Remove-Item $stage -Recurse -Force
                    }

                    if (Test-Path $zip) {
                        Remove-Item $zip -Force
                    }

                    New-Item -ItemType Directory -Path $stage | Out-Null

                    Write-Host "Copying project source files..."

                    robocopy $env:WORKSPACE $stage /E `
                        /XD .git node_modules deployment-package dist build `
                        /XF .env .env.local .env.production bikeledger-deploy.zip `
                        /NFL /NDL /NJH /NJS

                    $copyExitCode = $LASTEXITCODE

                    if ($copyExitCode -ge 8) {
                        throw "Robocopy failed with exit code $copyExitCode"
                    }

                    Write-Host "Source files copied successfully. Robocopy exit code: $copyExitCode"

                    $global:LASTEXITCODE = 0

                    # ======================================
                    # CREATE ZIP WITH FORWARD-SLASH PATHS
                    # ======================================

                    Add-Type -AssemblyName System.IO.Compression
                    Add-Type -AssemblyName System.IO.Compression.FileSystem

                    $fileStream = [System.IO.File]::Open(
                        $zip,
                        [System.IO.FileMode]::Create
                    )

                    try {
                        $archive = New-Object System.IO.Compression.ZipArchive(
                            $fileStream,
                            [System.IO.Compression.ZipArchiveMode]::Create
                        )

                        try {
                            Get-ChildItem -LiteralPath $stage -File -Recurse |
                                ForEach-Object {

                                    $relativePath = $_.FullName.Substring($stage.Length)

                                    $relativePath = $relativePath.TrimStart(
                                        [char[]]@('\','/')
                                    )

                                    $entryName = $relativePath.Replace('\','/')

                                    [System.IO.Compression.ZipFileExtensions]::CreateEntryFromFile(
                                        $archive,
                                        $_.FullName,
                                        $entryName
                                    ) | Out-Null
                                }
                        }
                        finally {
                            $archive.Dispose()
                        }
                    }
                    finally {
                        $fileStream.Dispose()
                    }

                    if (!(Test-Path $zip)) {
                        throw "Deployment ZIP was not created."
                    }

                    if ((Get-Item $zip).Length -eq 0) {
                        throw "Deployment ZIP is empty."
                    }

                    Write-Host "Linux-compatible deployment ZIP created successfully."

                    # Verify ZIP paths before transfer.
                    $verifyStream = [System.IO.File]::OpenRead($zip)

                    try {
                        $verifyArchive = New-Object System.IO.Compression.ZipArchive(
                            $verifyStream,
                            [System.IO.Compression.ZipArchiveMode]::Read
                        )

                        try {
                            $entries = @($verifyArchive.Entries | ForEach-Object {
                                $_.FullName
                            })

                            if (!($entries -contains "server/Dockerfile")) {
                                throw "ZIP verification failed: server/Dockerfile missing."
                            }

                            if (!($entries -contains "client/Dockerfile.prod")) {
                                throw "ZIP verification failed: client/Dockerfile.prod missing."
                            }

                            Write-Host "ZIP verification successful."
                            Write-Host "Backend Dockerfile found."
                            Write-Host "Frontend Dockerfile found."
                        }
                        finally {
                            $verifyArchive.Dispose()
                        }
                    }
                    finally {
                        $verifyStream.Dispose()
                    }

                    $global:LASTEXITCODE = 0

                    Write-Host "Deployment package created successfully."

                    exit 0
                '''
            }
        }

        // ==========================================
        // 3. DEPLOY TO AWS EC2
        // ==========================================

        stage('Deploy to AWS EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'bikeledger-ec2-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    ),
                    file(
                        credentialsId: 'bikeledger-env',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    powershell '''
                        $ErrorActionPreference = "Stop"

                        # ==========================================
                        # 1. SECURE SSH PRIVATE KEY
                        # ==========================================

                        Write-Host "Securing Jenkins SSH private key..."

                        $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name

                        & icacls.exe $env:SSH_KEY /inheritance:r

                        if ($LASTEXITCODE -ne 0) {
                            throw "Failed to remove inherited SSH key permissions."
                        }

                        & icacls.exe $env:SSH_KEY /grant:r "$($identity):(R)"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Failed to grant Jenkins account SSH key access."
                        }

                        Write-Host "SSH private key permissions secured."

                        # ==========================================
                        # 2. PREPARE VARIABLES
                        # ==========================================

                        $zip = Join-Path $env:WORKSPACE "bikeledger-deploy.zip"
                        $tag = $env:BUILD_NUMBER

                        if (!(Test-Path $zip)) {
                            throw "Deployment ZIP not found."
                        }

                        $sshOptions = @(
                            "-i", $env:SSH_KEY,
                            "-o", "StrictHostKeyChecking=accept-new",
                            "-o", "BatchMode=yes",
                            "-o", "ConnectTimeout=15"
                        )

                        $remote = "$($env:SSH_USER)@$($env:EC2_HOST)"
                        $buildDir = "/home/ec2-user/ci-builds/BikeLedger-$tag"

                        # ==========================================
                        # 3. TEST EC2 SSH CONNECTION
                        # ==========================================

                        Write-Host "Testing EC2 SSH connection..."

                        & ssh @sshOptions $remote "echo EC2_CONNECTION_SUCCESS"

                        if ($LASTEXITCODE -ne 0) {
                            throw "SSH connection to EC2 failed."
                        }

                        # ==========================================
                        # 4. VERIFY DOCKER AUTHENTICATION
                        # ==========================================

                        Write-Host "Checking existing EC2 Docker Hub authentication..."

                        & ssh @sshOptions $remote `
                            "sudo -n test -s /root/.docker/config.json"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker Hub authentication is not configured for EC2 root."
                        }

                        Write-Host "Existing EC2 Docker authentication found."

                        # ==========================================
                        # 5. PREPARE EC2 DIRECTORIES
                        # ==========================================

                        Write-Host "Preparing EC2 directories..."

                        $prepareCommand = "mkdir -p '$buildDir' '$($env:DEPLOY_DIR)' && find '$buildDir' -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +"

                        & ssh @sshOptions $remote $prepareCommand

                        if ($LASTEXITCODE -ne 0) {
                            throw "Could not prepare EC2 build directory."
                        }

                        # ==========================================
                        # 6. TRANSFER SOURCE ZIP
                        # ==========================================

                        Write-Host "Transferring source package..."

                        & scp @sshOptions $zip `
                            "${remote}:/tmp/bikeledger-$tag.zip"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Source package transfer failed."
                        }

                        # ==========================================
                        # 7. TRANSFER DOCKER COMPOSE FILE
                        # ==========================================

                        Write-Host "Transferring Compose file..."

                        & scp @sshOptions `
                            "$env:WORKSPACE\\docker-compose.prod.yml" `
                            "${remote}:$($env:DEPLOY_DIR)/docker-compose.prod.yml"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Compose file transfer failed."
                        }

                        # ==========================================
                        # 8. TRANSFER ENVIRONMENT SECRET FILE
                        # ==========================================

                        Write-Host "Transferring environment file..."

                        & scp @sshOptions $env:ENV_FILE `
                            "${remote}:$($env:DEPLOY_DIR)/.env"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Environment file transfer failed."
                        }

                        # ==========================================
                        # 9. CREATE LINUX EXTRACTION SCRIPT
                        # ==========================================

                        Write-Host "Creating Linux extraction script..."

                        $extractScript = @'
#!/bin/bash
set -euo pipefail

BUILD_TAG="__BUILD_TAG__"
BUILD_DIR="__BUILD_DIR__"
DEPLOY_DIR="__DEPLOY_DIR__"

ZIP_FILE="/tmp/bikeledger-$BUILD_TAG.zip"

echo "===================================="
echo "EXTRACTING BIKELEDGER SOURCE"
echo "===================================="

mkdir -p "$BUILD_DIR"

python3 -m zipfile -e "$ZIP_FILE" "$BUILD_DIR"

if [ ! -d "$BUILD_DIR/server" ]; then
    echo "ERROR: Backend server directory not found."
    exit 1
fi

if [ ! -d "$BUILD_DIR/client" ]; then
    echo "ERROR: Frontend client directory not found."
    exit 1
fi

if [ ! -f "$BUILD_DIR/server/Dockerfile" ]; then
    echo "ERROR: Backend Dockerfile not found."
    exit 1
fi

if [ ! -f "$BUILD_DIR/client/Dockerfile.prod" ]; then
    echo "ERROR: Frontend Dockerfile.prod not found."
    exit 1
fi

echo "Backend and frontend directories verified."

rm -f "$ZIP_FILE"

echo "Securing environment file..."

chmod 600 "$DEPLOY_DIR/.env"

echo "Source extraction completed successfully."
'@

                        $extractScript = $extractScript.Replace(
                            "__BUILD_TAG__", $tag
                        ).Replace(
                            "__BUILD_DIR__", $buildDir
                        ).Replace(
                            "__DEPLOY_DIR__", $env:DEPLOY_DIR
                        )

                        $extractScript = $extractScript -replace "`r`n", "`n"

                        $extractPath = Join-Path $env:WORKSPACE "ec2-extract.sh"

                        [System.IO.File]::WriteAllText(
                            $extractPath,
                            $extractScript,
                            [System.Text.Encoding]::ASCII
                        )

                        # ==========================================
                        # 10. TRANSFER AND EXECUTE EXTRACTION
                        # ==========================================

                        Write-Host "Transferring extraction script..."

                        & scp @sshOptions $extractPath `
                            "${remote}:/tmp/bikeledger-extract-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Extraction script transfer failed."
                        }

                        Write-Host "Executing extraction script on EC2..."

                        & ssh @sshOptions $remote `
                            "bash /tmp/bikeledger-extract-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 source extraction failed."
                        }

                        Write-Host "Source extraction completed successfully."

                        # ==========================================
                        # 11. CREATE REMOTE DEPLOYMENT SCRIPT
                        # ==========================================

                        $remoteScript = @'
#!/bin/bash
set -euo pipefail

BUILD_TAG="__BUILD_TAG__"
BUILD_DIR="__BUILD_DIR__"
DEPLOY_DIR="__DEPLOY_DIR__"

BACKEND="shanumukh/bikeledger-backend"
FRONTEND="shanumukh/bikeledger-frontend"

echo "===================================="
echo "VERIFYING SOURCE DIRECTORIES"
echo "===================================="

test -f "$BUILD_DIR/server/Dockerfile"
test -f "$BUILD_DIR/client/Dockerfile.prod"

echo "Source directories verified."

echo "===================================="
echo "BUILDING BIKELEDGER BACKEND"
echo "===================================="

sudo docker build \
  -t "$BACKEND:$BUILD_TAG" \
  -t "$BACKEND:latest" \
  -f "$BUILD_DIR/server/Dockerfile" \
  "$BUILD_DIR/server"

echo "===================================="
echo "BUILDING BIKELEDGER FRONTEND"
echo "===================================="

sudo docker build \
  --build-arg VITE_API_URL=/api \
  -t "$FRONTEND:$BUILD_TAG" \
  -t "$FRONTEND:latest" \
  -f "$BUILD_DIR/client/Dockerfile.prod" \
  "$BUILD_DIR/client"

echo "===================================="
echo "PUSHING IMAGES TO DOCKER HUB"
echo "===================================="

sudo docker push "$BACKEND:$BUILD_TAG"
sudo docker push "$BACKEND:latest"

sudo docker push "$FRONTEND:$BUILD_TAG"
sudo docker push "$FRONTEND:latest"

echo "===================================="
echo "VALIDATING DOCKER COMPOSE"
echo "===================================="

cd "$DEPLOY_DIR"

sudo docker compose \
  --env-file .env \
  -f docker-compose.prod.yml config -q

echo "===================================="
echo "DEPLOYING BIKELEDGER"
echo "===================================="

sudo env IMAGE_TAG="$BUILD_TAG" docker compose \
  --env-file .env \
  -f docker-compose.prod.yml \
  up -d --force-recreate

echo "===================================="
echo "CONTAINER STATUS"
echo "===================================="

sudo docker ps --filter "name=bikeledger-docker"

echo "===================================="
echo "BACKEND LOGS"
echo "===================================="

sudo docker logs --tail 30 bikeledger-docker-server

echo "===================================="
echo "DEPLOYMENT COMPLETED SUCCESSFULLY"
echo "===================================="
'@

                        $remoteScript = $remoteScript.Replace(
                            "__BUILD_TAG__", $tag
                        ).Replace(
                            "__BUILD_DIR__", $buildDir
                        ).Replace(
                            "__DEPLOY_DIR__", $env:DEPLOY_DIR
                        )

                        $remoteScript = $remoteScript -replace "`r`n", "`n"

                        $scriptPath = Join-Path $env:WORKSPACE "ec2-deploy.sh"

                        [System.IO.File]::WriteAllText(
                            $scriptPath,
                            $remoteScript,
                            [System.Text.Encoding]::ASCII
                        )

                        # ==========================================
                        # 12. TRANSFER DEPLOYMENT SCRIPT
                        # ==========================================

                        Write-Host "Transferring deployment script..."

                        & scp @sshOptions $scriptPath `
                            "${remote}:/tmp/bikeledger-deploy-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Deployment script transfer failed."
                        }

                        # ==========================================
                        # 13. EXECUTE DEPLOYMENT ON EC2
                        # ==========================================

                        Write-Host "Starting BikeLedger deployment on EC2..."

                        & ssh @sshOptions $remote `
                            "bash /tmp/bikeledger-deploy-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 deployment failed."
                        }

                        Write-Host "BikeLedger deployment completed successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'BikeLedger CI/CD deployment successful!'
        }

        failure {
            echo 'BikeLedger deployment failed. Check the stage logs.'
        }
    }
}
