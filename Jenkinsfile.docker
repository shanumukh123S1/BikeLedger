
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        EC2_HOST = '15.134.65.78'
        DEPLOY_DIR = '/home/ec2-user/BikeLedger-Docker'
        DOCKERHUB_USER = 'shanumukh'

        BACKEND_IMAGE = 'shanumukh/bikeledger-backend'
        FRONTEND_IMAGE = 'shanumukh/bikeledger-frontend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Prepare Deployment Package') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"

                    $stage = Join-Path $env:WORKSPACE "deployment-package"
                    $zip = Join-Path $env:WORKSPACE "bikeledger-deploy.zip"

                    if (Test-Path $stage) {
                        Remove-Item $stage -Recurse -Force
                    }

                    if (Test-Path $zip) {
                        Remove-Item $zip -Force
                    }

                    New-Item -ItemType Directory -Path $stage | Out-Null

                    robocopy $env:WORKSPACE $stage /E `
                        /XD .git node_modules deployment-package `
                            dist build `
                        /XF .env .env.local .env.production `
                        bikeledger-deploy.zip

                    if ($LASTEXITCODE -ge 8) {
                        throw "Failed to prepare deployment package."
                    }

                    Compress-Archive -Path "$stage\\*" `
                        -DestinationPath $zip -Force

                    Write-Host "Deployment package created."
                '''
            }
        }

        stage('Deploy to AWS EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'bikeledger-ec2-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    ),
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    ),
                    file(
                        credentialsId: 'bikeledger-env',
                        variable: 'ENV_FILE'
                    )
                ]) {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $zip = Join-Path $env:WORKSPACE "bikeledger-deploy.zip"
                        $tag = $env:BUILD_NUMBER

                        $sshOptions = @(
                            "-i", $env:SSH_KEY,
                            "-o", "StrictHostKeyChecking=accept-new"
                        )

                        $remote = "$($env:SSH_USER)@$($env:EC2_HOST)"

                        # Create an isolated build directory on EC2.
                        $buildDir = "/home/ec2-user/ci-builds/BikeLedger-$tag"

                        & ssh @sshOptions $remote `
                            "mkdir -p '$buildDir' '$($env:DEPLOY_DIR)'"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Could not prepare EC2 directories."
                        }

                        # Transfer source package.
                        & scp @sshOptions $zip `
                            "${remote}:/tmp/bikeledger-$tag.zip"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Source package transfer failed."
                        }

                        # Transfer production Compose file.
                        & scp @sshOptions `
                            "$env:WORKSPACE\\docker-compose.prod.yml" `
                            "${remote}:$($env:DEPLOY_DIR)/docker-compose.prod.yml"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Compose file transfer failed."
                        }

                        # Transfer Jenkins Secret File (.env).
                        & scp @sshOptions $env:ENV_FILE `
                            "${remote}:$($env:DEPLOY_DIR)/.env"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Environment file transfer failed."
                        }

                        # Extract source and protect the environment file.
                        $extractCommand = @"
set -e
python3 -m zipfile -e /tmp/bikeledger-$tag.zip '$buildDir'
rm -f /tmp/bikeledger-$tag.zip
chmod 600 '$($env:DEPLOY_DIR)/.env'
"@

                        $extractCommand | ssh @sshOptions $remote "bash -s"

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 source extraction failed."
                        }

                        # Docker Hub login on EC2.
                        # The token is passed through stdin, not as a command argument.
                        $env:DH_TOKEN | ssh @sshOptions $remote `
                            "sudo docker login --username $env:DH_USER --password-stdin"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker Hub login failed on EC2."
                        }

                        # Create the remote deployment script.
                        $remoteScript = @'
#!/bin/bash
set -euo pipefail

BUILD_TAG="__BUILD_TAG__"
BUILD_DIR="__BUILD_DIR__"
DEPLOY_DIR="__DEPLOY_DIR__"

BACKEND="shanumukh/bikeledger-backend"
FRONTEND="shanumukh/bikeledger-frontend"

echo "Building backend on EC2..."
sudo docker build \
  -t "$BACKEND:$BUILD_TAG" \
  -t "$BACKEND:latest" \
  -f "$BUILD_DIR/server/Dockerfile" \
  "$BUILD_DIR/server"

echo "Building frontend on EC2..."
sudo docker build \
  --build-arg VITE_API_URL=/api \
  -t "$FRONTEND:$BUILD_TAG" \
  -t "$FRONTEND:latest" \
  -f "$BUILD_DIR/client/Dockerfile.prod" \
  "$BUILD_DIR/client"

echo "Pushing images to Docker Hub..."
sudo docker push "$BACKEND:$BUILD_TAG"
sudo docker push "$BACKEND:latest"
sudo docker push "$FRONTEND:$BUILD_TAG"
sudo docker push "$FRONTEND:latest"

echo "Validating deployment configuration..."
cd "$DEPLOY_DIR"

sudo docker compose \
  --env-file .env \
  -f docker-compose.prod.yml config -q

echo "Starting BikeLedger containers..."
sudo env IMAGE_TAG="$BUILD_TAG" docker compose \
  --env-file .env \
  -f docker-compose.prod.yml \
  up -d --force-recreate

echo "Container status:"
sudo docker ps --filter "name=bikeledger-docker"

echo "Backend logs:"
sudo docker logs --tail 30 bikeledger-docker-server

echo "Deployment completed."
'@

                        $remoteScript = $remoteScript.Replace(
                            "__BUILD_TAG__", $tag
                        ).Replace(
                            "__BUILD_DIR__", $buildDir
                        ).Replace(
                            "__DEPLOY_DIR__", $env:DEPLOY_DIR
                        )

                        $scriptPath = Join-Path $env:WORKSPACE "ec2-deploy.sh"

                        Set-Content -Path $scriptPath `
                            -Value $remoteScript -Encoding ascii

                        & scp @sshOptions $scriptPath `
                            "${remote}:/tmp/bikeledger-deploy-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "Deployment script transfer failed."
                        }

                        ssh @sshOptions $remote `
                            "bash /tmp/bikeledger-deploy-$tag.sh"

                        if ($LASTEXITCODE -ne 0) {
                            throw "EC2 deployment failed."
                        }

                        Write-Host "BikeLedger deployment completed."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'BikeLedger CI/CD deployment successful!'
        }

        failure {
            echo 'BikeLedger deployment failed. Check the stage logs.'
        }
    }
}
